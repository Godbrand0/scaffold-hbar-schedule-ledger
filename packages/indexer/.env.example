# Copy to .env (yarn indexer:start reads it from packages/indexer/.env).

# Required: the deployed RecurringPayments contract, as a 0x EVM address or a 0.0.N Hedera ID.
# Find it in packages/foundry/deployments/296.json after `yarn foundry:deploy:testnet`.
CONTRACT_ADDRESS=

# Mirror node REST base URL (testnet default). Use https://mainnet.mirrornode.hedera.com for mainnet.
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Where the SQLite database lives, and where the HTTP API listens.
DATABASE_PATH=indexer.db
BIND_ADDR=127.0.0.1:4000

# Seconds between mirror node polls.
POLL_INTERVAL_SECS=5

# A booked run counts as overdue this many seconds after its expiry if nothing paid it.
OVERDUE_GRACE_SECS=60
